# Yamaha TF Showbuilder Configuration

# TF-Rack Connection
TF_RACK_IP=192.168.1.100
TF_RACK_PORT=49280

# Dante Discovery
DANTE_DISCOVERY_ENABLED=true

# E-Ink Displays
EINK_ENABLED=true
EINK_DISPLAY_COUNT=16

# Database
DATABASE_URL=sqlite:///./data/showbuilder.db

# Redis (for caching and pub/sub)
REDIS_URL=redis://redis:6379

# Debug mode
DEBUG=false
